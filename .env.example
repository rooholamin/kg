# Prisma Config #
# NOTE: This project no longer uses Supabase. All data lives on the
# production server's own PostgreSQL 17 instance (DB `kghub_prod`, localhost
# only on the server — see .cursor/rules/server-deployment.mdc for
# credentials/architecture). There is no shared hosted dev DB; point these at
# your own local Postgres, or an SSH tunnel to the production DB if you have
# access. DIRECT_URL can be the same value as DATABASE_URL now (no pgbouncer).
DATABASE_URL="postgresql://user:password@localhost:5432/kghub_dev"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/kghub_dev"

# Next Auth Config #
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_PATH=http://localhost:3000/
NEXTAUTH_URL=http://localhost:3000/
NEXTAUTH_SECRET=N3G2xT44ovZWp24HUQE54JRJq63ZOhhOHe1uQnsQxs4=
GOOGLE_CLIENT_ID=your_gogle_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_gogle_oauth2_secret_key

# Storage Configuration (AWS S3 or DigitalOcean Spaces)
STORAGE_TYPE=digitalocean

STORAGE_ACCESS_KEY_ID=your_do_spaces_access_key
STORAGE_SECRET_ACCESS_KEY=your_do_spaces_secret_key
STORAGE_REGION=tor1
STORAGE_BUCKET=kghub
STORAGE_ENDPOINT=https://tor1.digitaloceanspaces.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_CDN_URL=https://kghub.tor1.digitaloceanspaces.com

# SMTP Credentials
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_SECURE=false
SMTP_USER=no-reply@domain.com
SMTP_PASS=your_smtp_pass

# Additional Optional Settings
SMTP_SENDER=KGHub
SMTP_FROM=no-reply@domain.com

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Base URL
BASE_URL = /

# n8n Integration (Milestone 8)
# Webhook n8n sends TO this app after generating an article plan
N8N_WEBHOOK_URL=https://n8n.rooholamin.net/webhook/article-planning
# URL this app hits to check if n8n is alive
N8N_HEALTH_URL=https://n8n.rooholamin.net/webhook/health
# Shared secret — must match the value set in the n8n workflow headers
N8N_WEBHOOK_SECRET=your-shared-secret

# Article Automation Workflows (Milestone 9)
N8N_RESEARCH_WEBHOOK_URL=https://n8n.rooholamin.net/webhook/article-research
N8N_WRITING_WEBHOOK_URL=https://n8n.rooholamin.net/webhook/article-writing
N8N_IMAGE_GEN_WEBHOOK_URL=https://n8n.rooholamin.net/webhook/article-image-gen
N8N_PROMPT_REFINER_WEBHOOK_URL=https://n8n.rooholamin.net/webhook/prompt-refiner
# Social Content Pipeline
ANTHROPIC_API_KEY=
# Buffer API key — the only Buffer secret needed here.
# Channel IDs (Instagram, LinkedIn, Twitter) are stored in the DB via Social → Settings.
BUFFER_ACCESS_TOKEN=

# Video Campaign Pipeline — directed via Higgsfield's hosted MCP server
# (mcp.higgsfield.ai), not a direct API key. Agent/environment IDs and the
# Anthropic Vault ID holding the Higgsfield MCP OAuth credential all live in
# the DB via Video → Settings, same pattern as above. No env vars needed here.

# ElevenLabs Music API — duration-matched instrumental background music,
# mixed under the narration during video assembly (services/elevenlabs.service.js)
ELEVENLABS_API_KEY=

# Captions.ai (Mirage API) — animated captions burned into the assembled
# video (services/captions-ai.service.js). Requires 9:16 input, max 50MB.
CAPTIONS_AI_API_KEY=

# Optional overrides if ffmpeg/ffprobe aren't on PATH (services/video-assembly.service.js)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# SEO Pipeline — "seo" (on-page, per-article) + "kingsgate-linking" (batch-of-N
# selective backlink) engines. Agent/environment IDs live in the DB via
# SEO → Settings, same pattern as Social/Video. The two env vars below are
# the only secrets needed here.

# Shared secret the two SEO Managed Agents send as a Bearer token when
# calling our own internal MCP server (app/api/mcp/seo). Register the same
# value as a static_bearer credential in an Anthropic vault pointed at this
# server's URL, then set SeoSettings.mcpVaultId to that vault's id — see
# scripts/create-mcp-vault.mjs.
MCP_SEO_SECRET=

# Read-only WordPress Application Password for kingsgateluxuryhomes.com
# (Kingsgate's business site — NOT insights.kghub.ca, which already has
# credentials via the Section model). Used only by
# get_kingsgate_posts_for_feature to look up real posts tagged with a home
# feature; this app never writes to kingsgateluxuryhomes.com.
KINGSGATE_WP_SITE_URL=https://kingsgateluxuryhomes.com
KINGSGATE_WP_USERNAME=
KINGSGATE_WP_APP_PASSWORD=