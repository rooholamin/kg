generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Modoule
enum UserStatus {
  INACTIVE
  ACTIVE
  BLOCKED
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  password        String?
  country         String?
  timezone        String?
  name            String?
  roleId          String
  status          UserStatus  @default(INACTIVE) // Status of the invitation
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastSignInAt    DateTime?
  emailVerifiedAt DateTime?
  isTrashed       Boolean     @default(false)
  avatar          String?
  invitedByUserId String?
  isProtected     Boolean     @default(false) // Prevents deletion/modification
  role            UserRole    @relation(fields: [roleId], references: [id])
  systemLog       SystemLog[]
  accounts        Account[]
  Session         Session[]

  // Indexes for efficient querying
  @@index([invitedByUserId])
  @@index([roleId])
  @@index([status])
}

model UserRole {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String               @unique
  description     String?
  isTrashed       Boolean              @default(false)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  isProtected     Boolean              @default(false)
  isDefault       Boolean              @default(false)
  users           User[]
  permissions     UserRolePermission[]
}

model UserPermission {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String
  description     String?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  roles           UserRolePermission[]
}

model UserRolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemLog {
  id          String   @id @default(uuid())
  userId      String
  createdAt   DateTime @default(now())
  entityId    String?
  entityType  String?
  event       String?
  description String?
  ipAddress   String?
  meta        String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemSetting {
  id             String  @id @default(uuid())
  name           String  @default("My Company")
  logo           String?
  active         Boolean @default(true)
  address        String?
  websiteURL     String?
  supportEmail   String?
  supportPhone   String?
  language       String  @default("en")
  timezone       String  @default("UTC")
  currency       String  @default("USD")
  currencyFormat String  @default("$ {value}")

  socialFacebook  String?
  socialTwitter   String?
  socialInstagram String?
  socialLinkedIn  String?
  socialPinterest String?
  socialYoutube   String?

  notifyStockEmail               Boolean  @default(true)
  notifyStockWeb                 Boolean  @default(true)
  notifyStockThreshold           Int      @default(10)
  notifyStockRoleIds             String[]
  notifyNewOrderEmail            Boolean  @default(true)
  notifyNewOrderWeb              Boolean  @default(true)
  notifyNewOrderRoleIds          String[]
  notifyOrderStatusUpdateEmail   Boolean  @default(true)
  notifyOrderStatusUpdateWeb     Boolean  @default(true)
  notifyOrderStatusUpdateRoleIds String[]
  notifyPaymentFailureEmail      Boolean  @default(true)
  notifyPaymentFailureWeb        Boolean  @default(true)
  notifyPaymentFailureRoleIds    String[]
  notifySystemErrorFailureEmail  Boolean  @default(true)
  notifySystemErrorWeb           Boolean  @default(true)
  notifySystemErrorRoleIds       String[]
}

// Content hierarchy — Section → Category → Topic → Article
enum SectionStatus {
  active
  archived
}

enum CategoryStatus {
  active
  archived
}

enum TopicStatus {
  active
  archived
}

/// Pipeline stage (single article status)
enum ArticleStatus {
  planning
  research
  writing
  assets
  approval
  scheduling
  publishing
  post_publish
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Section {
  id                     String        @id @default(uuid())
  name                   String
  slug                   String        @unique
  description            String?
  summary                String?
  icon                   String?
  status                 SectionStatus @default(active)
  characterName          String?
  characterBackground    String?
  characterRole          String?
  characterAge           String?
  characterBiography     String?       @db.Text
  characterTone          String?
  characterWritingStyle  String?       @db.Text
  characterSampleVoice   String?       @db.Text
  characterPersona       String?       @db.Text
  characterImage         String?
  // WordPress integration — credentials for the author persona of this section
  wpSiteUrl              String?
  wpUsername             String?
  wpAppPassword          String?
  wpAuthorId             Int?
  // Social media template colors — fed into {{COLOR_ACCENT/LIGHT/DARK}} placeholders
  colorAccent            String?
  colorLight             String?
  colorDark              String?
  // Baseline hashtags prepended to AI-generated hashtags for social posts
  socialHashtags         String[]      @default([])
  // Video pipeline — Higgsfield Reference Element ID created from characterImage
  // (+ any extra ref shots) via the Character Admin Agent, reused as this
  // section's on-screen avatar in generate_image/generate_video prompts
  // (embedded as a <<<elementId>>> placeholder). NOT a Soul Character ID —
  // those are a separate, incompatible system only usable with Soul V2/Cinema
  // still-image models, not with Seedance 2.0/Kling 3.0 video generation.
  videoCharacterId       String?
  videoRefImageUrls      String[]      @default([])
  videoOutfitDescription String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  categories             Category[]
  // Custom videos that borrow this section's trained character
  customVideoPosts       VideoPost[]

  @@index([status])
  @@index([slug])
}

model Category {
  id           String         @id @default(uuid())
  name         String
  description  String?
  status       CategoryStatus @default(active)
  sectionId    String?
  wpCategoryId Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  section      Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  topics       Topic[]
  articles     Article[]

  @@index([status])
  @@index([sectionId])
}

model Topic {
  id            String      @id @default(uuid())
  name          String
  description   String?
  categoryId    String
  targetKeyword String?
  status        TopicStatus @default(active)
  wpCategoryId  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles      Article[]

  @@index([categoryId])
  @@index([status])
}

model Article {
  id                     String                 @id @default(uuid())
  title                  String
  /// TipTap / ProseMirror doc: { type: "doc", content: [...] }
  summary                String?
  content                Json?
  featuredImage          String?
  galleryImages          String[]               @default([])
  videoUrl               String?
  isEditorsChoice        Boolean                @default(false)
  views                  Int                    @default(0)
  likes                  Int                    @default(0)
  commentsCount          Int                    @default(0)
  topicId                String
  categoryId             String
  status                 ArticleStatus          @default(planning)
  publishDate            DateTime?
  readinessDeadline      DateTime?
  seoScore               Int?
  wordpressPostId        Int?
  approvedById           String?
  approvedAt             DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  scheduleBatchId        String?
  scheduledSlotId        String?
  generationSource       String?
  // AI planning fields (populated when slot is promoted to article)
  articleAngle           String?                @db.Text
  seoKeywords            String[]               @default([])
  outline                Json?
  featuredImagePrompt    String?                @db.Text
  inlineImagePrompts     Json?
  videoIdea              String?                @db.Text
  metaDescription        String?                @db.Text
  // Shared Managed Agent session for social content generation across all platforms
  socialContentSessionId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  topic                  Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  versions               ArticleVersion[]
  scheduledSlots         ScheduledArticleSlot[]
  research               ArticleResearch?
  assetRequests          ArticleAssetRequest[]
  automationRuns         ArticleAutomationRun[]
  pipelineEngineLogs     PipelineEngineLog[]
  socialPosts            SocialPost[]
  videoPosts             VideoPost[]

  @@index([topicId])
  @@index([categoryId])
  @@index([status])
  @@index([isEditorsChoice])
  @@index([scheduleBatchId])
  @@index([scheduledSlotId])
}

/// Snapshot of article body before an update (important fields)
model ArticleVersion {
  id           String   @id @default(uuid())
  articleId    String
  title        String
  summary      String?
  content      Json?
  versionLabel String?
  createdBy    String?
  createdAt    DateTime @default(now())
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
}

enum AIAttemptStatus {
  success
  failed
}

enum AIAttemptType {
  planning
  research
  writing
  image_generation
}

/// AI generation attempts — one row per n8n call or redo
model AIAttempt {
  id          String          @id @default(uuid())
  articleId   String?
  slotId      String?
  type        AIAttemptType
  prompt      String?         @db.Text
  result      String?         @db.Text
  model       String
  status      AIAttemptStatus @default(success)
  isRedo      Boolean         @default(false)
  triggeredBy String?
  createdAt   DateTime        @default(now())

  @@index([articleId])
  @@index([slotId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Content-operation events (separate from SystemLog user-activity)
model ContentLog {
  id         String   @id @default(uuid())
  /// category | topic | article | project | system
  type       String
  /// create | update | delete | archive | status_change
  action     String?
  message    String
  entityType String?
  entityId   String?
  metadata   Json?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([type])
}

model Approval {
  id          String         @id @default(uuid())
  type        String
  status      ApprovalStatus @default(pending)
  requestedBy String
  createdAt   DateTime       @default(now())

  @@index([status])
}

enum ProjectPhaseSlug {
  build
  automation
}

enum WorkstreamStatus {
  not_started
  in_progress
  completed
  blocked
}

enum MilestoneStatus {
  not_started
  in_progress
  completed
  blocked
}

enum MilestoneType {
  build
  automation
}

enum BlockerSeverity {
  low
  medium
  high
  critical
}

enum BlockerStatus {
  open
  resolved
}

enum IdeaPriority {
  low
  medium
  high
}

enum IdeaStatus {
  new
  under_consideration
  accepted
  rejected
  parked
}

model ProjectPhase {
  id              String              @id @default(uuid())
  slug            ProjectPhaseSlug    @unique
  title           String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  progressPercent Int                 @default(0)
  sortOrder       Int                 @default(0)
  workstreams     ProjectWorkstream[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([sortOrder])
}

model ProjectWorkstream {
  id              String             @id @default(uuid())
  phaseId         String
  name            String
  description     String?
  status          WorkstreamStatus   @default(not_started)
  progressPercent Int                @default(0)
  sortOrder       Int                @default(0)
  phase           ProjectPhase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  milestones      ProjectMilestone[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([phaseId])
  @@index([status])
  @@index([sortOrder])
}

model ProjectMilestone {
  id              String            @id @default(uuid())
  workstreamId    String
  title           String
  description     String?
  status          MilestoneStatus   @default(not_started)
  type            MilestoneType
  startDate       DateTime?
  endDate         DateTime?
  progressPercent Int               @default(0)
  sortOrder       Int               @default(0)
  workstream      ProjectWorkstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  blockers        ProjectBlocker[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workstreamId])
  @@index([type])
  @@index([status])
  @@index([sortOrder])
}

model ProjectBlocker {
  id          String            @id @default(uuid())
  milestoneId String?
  title       String
  description String?
  severity    BlockerSeverity   @default(medium)
  status      BlockerStatus     @default(open)
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime          @updatedAt
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([status])
  @@index([severity])
}

model ProjectProgressReport {
  id                 String   @id @default(uuid())
  title              String
  summary            String
  buildProgress      Int
  automationProgress Int
  keyFocus           String?
  blockersSummary    String?
  createdAt          DateTime @default(now())
}

model IdeaBacklog {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    IdeaPriority @default(medium)
  status      IdeaStatus   @default(new)
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([priority])
  @@index([status])
  @@index([createdAt])
}

// Scheduling Engine — Milestone 8
enum ScheduleBatchStatus {
  draft
  scheduled
  running
  paused
  completed
  failed
}

enum ScheduledSlotStatus {
  planned
  sent_to_n8n
  generating
  completed
  failed
}

model ScheduleBatch {
  id              String                 @id @default(uuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  postsPerDay     Int
  status          ScheduleBatchStatus    @default(draft)
  totalSlots      Int                    @default(0)
  completedSlots  Int                    @default(0)
  failedSlots     Int                    @default(0)
  sectionIds      String[]               @default([])
  categoryIds     String[]               @default([])
  excludeTopicIds String[]               @default([])
  /// "n8n_unavailable" | "manual" | null
  pauseReason     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  slots           ScheduledArticleSlot[]

  @@index([status])
  @@index([createdAt])
}

model ScheduledArticleSlot {
  id             String              @id @default(uuid())
  batchId        String
  articleId      String?
  sectionId      String?
  categoryId     String
  topicId        String
  scheduledDate  DateTime
  position       Int                 @default(0)
  status         ScheduledSlotStatus @default(planned)
  n8nExecutionId String?
  errorMessage   String?
  planningData   Json?
  triggeredAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  batch          ScheduleBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  article        Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([articleId])
  @@index([topicId])
  @@index([status])
  @@index([scheduledDate])
}

// Pipeline Engine — batch article automation

enum PipelineEngineStatus {
  idle
  running
  paused
}

/// One row per engine type: "research" | "writing" | "images"
model PipelineEngine {
  id                 String               @id // "research" | "writing" | "images"
  status             PipelineEngineStatus @default(idle)
  pauseReason        String?
  currentArticleId   String?
  currentStep        String? // "research" | "writing" | "assets"
  delayMinutes       Int                  @default(0) // wait N minutes between jobs
  lastJobCompletedAt DateTime?
  totalProcessed     Int                  @default(0)
  totalFailed        Int                  @default(0)
  updatedAt          DateTime             @updatedAt
}

/// Immutable log entry for each article step processed by the pipeline engine
model PipelineEngineLog {
  id          String    @id @default(uuid())
  engineId    String? // "research" | "writing" | "images" (null = legacy)
  articleId   String
  steps       String[]
  status      String // "completed" | "failed"
  error       String?
  startedAt   DateTime
  completedAt DateTime?
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([engineId])
  @@index([articleId])
  @@index([status])
  @@index([startedAt])
}

// Article Automation — Milestone 9

/// One-to-one research result per article
model ArticleResearch {
  id            String   @id @default(uuid())
  articleId     String   @unique
  sources       Json?
  notes         Json?
  keyFacts      Json?
  searchQueries Json?
  summary       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

enum AssetRequestType {
  featured_image
  inline_image
  diagram
  chart
  social_asset
}

enum AssetRequestStatus {
  pending
  generating
  completed
  failed
}

/// One row per image/asset that needs to be generated for an article
model ArticleAssetRequest {
  id           String                @id @default(uuid())
  articleId    String
  type         AssetRequestType
  prompt       String                @db.Text
  placementKey String
  status       AssetRequestStatus    @default(pending)
  imageUrl     String?
  errorMessage String?
  version      Int                   @default(1)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  article      Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  history      ArticleAssetHistory[]

  @@index([articleId])
  @@index([status])
}

/// Previous versions of a generated asset image (kept when a redo replaces the image)
model ArticleAssetHistory {
  id             String              @id @default(uuid())
  assetRequestId String
  imageUrl       String
  prompt         String?             @db.Text
  version        Int
  createdAt      DateTime            @default(now())
  assetRequest   ArticleAssetRequest @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)

  @@index([assetRequestId])
}

enum AutomationRunWorkflow {
  research
  writing
  image_generation
}

enum AutomationRunStatus {
  running
  completed
  failed
}

/// Audit trail for every n8n workflow execution triggered for an article
model ArticleAutomationRun {
  id             String                @id @default(uuid())
  articleId      String
  workflowType   AutomationRunWorkflow
  n8nExecutionId String?
  status         AutomationRunStatus   @default(running)
  input          Json?
  output         Json?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  article        Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([workflowType])
  @@index([status])
}

// ─── Social Content Pipeline ──────────────────────────────────────────────────

enum SocialCampaignStatus {
  pending
  running
  content_generating
  exporting
  scheduling
  reviewing
  paused
  done
  failed
  cancelled
}

enum SocialPlatform {
  instagram_carousel
  instagram_story
  linkedin
  twitter
}

enum SocialPostStatus {
  pending
  content_generating
  content_ready
  exporting
  uploaded
  scheduling
  scheduled
  failed
}

model SocialCampaign {
  id                  String               @id @default(uuid())
  weekStart           DateTime
  weekEnd             DateTime
  status              SocialCampaignStatus @default(pending)
  // Article publishDate filter, independent of the weekStart/weekEnd posting
  // window above. Null means "use weekStart/weekEnd" (legacy behavior).
  articleDateStart    DateTime?
  articleDateEnd      DateTime?
  // Settings captured at creation time (copied from SocialSettings defaults)
  maxPostsPerPlatform Json
  campaignBrief       String?              @db.Text
  editorsChoiceOnly   Boolean              @default(false)
  includeSections     String[]             @default([])
  // Managed Agent session ID used for this campaign's approval (audit trail)
  approvalSessionId   String?
  posts               SocialPost[]
  logs                SocialCampaignLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([weekStart])
}

model SocialPost {
  id             String           @id @default(uuid())
  campaignId     String
  articleId      String
  platform       SocialPlatform
  status         SocialPostStatus @default(pending)
  // Ordered slide IDs; carousel: 4-7 slides; story/linkedin: 1 element
  slideIds       String[]         @default([])
  // Caption editable by user before scheduling; AI-generated initially
  generatedText  String?          @db.Text
  hashtags       String[]         @default([])
  // Ordered CDN URLs matching slideIds order (empty for Twitter)
  imageUrls      String[]         @default([])
  // All {{PLACEHOLDER}} values from AI (STATEMENT_TEXT, QUOTE, STAT_N, etc.)
  placeholders   Json?
  // Per-slide HERO_IMAGE assignment chosen by the content agent: { "<slideId>": "<url>" }
  slideImages    Json?
  // Export progress tracking (enables "slide X/Y" UI)
  exportProgress Int              @default(0)
  exportTotal    Int              @default(0)
  bufferPostId   String?
  scheduledAt    DateTime?
  analyticsData  Json?
  errorMessage   String?          @db.Text
  campaign       SocialCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  article        Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([campaignId])
  @@index([articleId])
  @@index([platform])
  @@index([status])
}

/// Detailed trace of every pipeline step — used for the live run log UI
model SocialCampaignLog {
  id         String         @id @default(uuid())
  campaignId String
  postId     String?
  // e.g. 'approval_fetch', 'approval_ai_send', 'approval_ai_receive', 'content_session',
  //      'content_ai_send', 'content_ai_receive', 'export_slide', 'export_upload', 'schedule_buffer'
  step       String
  // 'running' | 'done' | 'error'
  status     String         @default("running")
  // Human-readable summary shown in the UI
  message    String?        @db.Text
  // Raw input data (message sent to AI, export params, Buffer payload…)
  input      Json?
  // Raw output data (AI response, S3 URL, Buffer post ID…)
  output     Json?
  campaign   SocialCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([campaignId])
  @@index([postId])
  @@index([step])
}

/// Global defaults + Buffer profile IDs + Anthropic Managed Agent references
model SocialSettings {
  id                           String   @id @default("singleton")
  // Anthropic Managed Agent IDs (created manually in Anthropic Console)
  approvalAgentId              String?
  approvalEnvironmentId        String?
  // Content generation agent — separate agent, one session per post
  contentAgentId               String?
  contentEnvironmentId         String?
  // Buffer channel IDs (new GraphQL API — one channel per platform)
  instagramChannelId           String?
  linkedinChannelId            String?
  twitterChannelId             String?
  // Legacy Buffer profile IDs (kept for rollback safety — no longer used)
  instagramCarouselProfileId   String?
  instagramStoryProfileId      String?
  linkedinProfileId            String?
  twitterProfileId             String?
  // Default max posts per platform per week (overridable per campaign)
  defaultMaxInstagramCarousel  Int      @default(3)
  defaultMaxInstagramStory     Int      @default(5)
  defaultMaxLinkedin           Int      @default(3)
  defaultMaxTwitter            Int      @default(7)
  // Per-platform posting windows; day bitmask (bit 0=Sun … bit 6=Sat)
  instagramCarouselDays        Int      @default(28)
  instagramCarouselWindowStart String   @default("10:00")
  instagramCarouselWindowEnd   String   @default("10:00")
  instagramStoryDays           Int      @default(62)
  instagramStoryWindowStart    String   @default("08:00")
  instagramStoryWindowEnd      String   @default("20:00")
  linkedinDays                 Int      @default(20)
  linkedinWindowStart          String   @default("09:00")
  linkedinWindowEnd            String   @default("09:00")
  twitterDays                  Int      @default(42)
  twitterWindowStart           String   @default("10:00")
  twitterWindowEnd             String   @default("10:00")
  lookbackDays                 Int      @default(30)
  // UTC offset for posting windows (e.g. -4 for US Eastern Daylight Time)
  timezoneOffset               Int      @default(0)
  // When false: pipeline auto-schedules immediately after upload (no review pause)
  requireReview                Boolean  @default(true)
  disabledTemplates            String[] @default([])
  updatedAt                    DateTime @updatedAt
}

/// Runtime state for the ongoing Anthropic Managed Agent approval session
model SocialAiMemory {
  id                   String   @id @default("singleton")
  // Active session ID — reused across multiple campaigns; null = create new session next run
  activeSessionId      String?
  // How many campaigns have been approved in this session
  sessionCampaignCount Int      @default(0)
  // Rotate to a new session after this many campaigns
  sessionRotateAfter   Int      @default(10)
  // Handoff summary written by the agent at rotation; injected as first message in new session
  handoffSummary       String?  @db.Text
  updatedAt            DateTime @updatedAt
}

// ─── Video Campaign Pipeline ──────────────────────────────────────────────────
// Two Managed Agents: a Video Approval Agent selects which published articles
// get a video this cycle, then a Video Director Agent writes an independent
// multi-shot script (shotList) per approved article and directs the Higgsfield
// shoot via custom tools (generate_image/generate_video/get_generation_status).
// Each section's existing character persona (Section.videoCharacterId, a
// trained Higgsfield Soul Character) is the on-screen avatar; every video
// shares the one VideoEnvironment singleton ("KG Media Loft").

enum VideoCampaignStatus {
  pending
  running
  approving
  planning
  directing
  exporting
  reviewing
  scheduling
  paused
  done
  failed
  cancelled
}

// pending -> planning (Phase 1, agent drafts plan) -> plan_ready (Phase 2, awaiting
// human approval) -> approved (Phase 3 about to execute) -> directing (executing,
// materializing VideoSegment rows) -> content_ready (assembled by our own
// video-assembly.service.js) -> exporting -> uploaded -> scheduling -> scheduled
enum VideoPostStatus {
  pending
  planning
  plan_ready
  approved
  directing
  content_ready
  exporting
  uploaded
  scheduling
  scheduled
  failed
}

enum VideoSegmentStatus {
  pending
  generating
  completed
  failed
}

enum VideoSegmentVersionSource {
  // Produced by the director agent (initial shoot or a regeneration)
  generated
  // A URL pasted in by a human — e.g. recovering a Higgsfield clip whose job
  // id was lost when a director session died mid-shoot
  manual
}

/// Platform presets feed sensible defaults (aspect ratio, duration range, tone) into
/// the Plan phase brief — all four still overridable per campaign/post.
enum VideoTargetPlatform {
  instagram_reels
  tiktok
  youtube_shorts
  linkedin
  auto
}

enum VideoStyle {
  auto
  explainer
  diy
  listicle
  testimonial
}

/// Singleton — the one shared environment every video is shot "in"
model VideoEnvironment {
  id              String   @id @default("singleton")
  name            String   @default("KG Media Loft")
  // 7-point descriptor (architecture, texture, scale, atmosphere, light, colour, mood) —
  // dropped into the director agent's prompt as TEXT rather than an image ref, to
  // avoid "ref bleeding" (see Universal AI Cinematic Automation/env-descriptors.md)
  textDescriptor  String?  @db.Text
  refImageUrl     String?
  higgsfieldRefId String?
  updatedAt       DateTime @updatedAt
}

enum VideoCampaignSelectionMode {
  agent
  manual
}

model VideoCampaign {
  id                String                     @id @default(uuid())
  weekStart         DateTime
  weekEnd           DateTime
  status            VideoCampaignStatus        @default(pending)
  // agent = the Video Approval Agent picks articles (existing flow); manual =
  // articles were hand-picked day-by-day at creation time and posts were
  // created directly, skipping runVideoApproval entirely.
  selectionMode     VideoCampaignSelectionMode @default(agent)
  // Article publishDate filter, independent of weekStart/weekEnd (same pattern as SocialCampaign).
  // Unused when selectionMode is "manual" or for video in general now that
  // candidate eligibility no longer depends on publish date (see
  // videoArticleEligibilityWhere in services/video-pipeline.service.js).
  articleDateStart  DateTime?
  articleDateEnd    DateTime?
  // Selection guidance for the Video Approval Agent — NOT a shared script;
  // each approved article gets its own independently-written shotList.
  campaignBrief     String?                    @db.Text
  editorsChoiceOnly Boolean                    @default(false)
  includeSections   String[]                   @default([])
  maxVideos         Int?
  // Plan → Approve → Execute configuration — cycle-level defaults, each
  // individually overridable per-post (VideoPost has the same four fields).
  targetPlatform    VideoTargetPlatform?       @default(auto)
  videoStyle        VideoStyle?                @default(auto)
  // Optional exact/target segment count — null means the director agent
  // decides freely (confirmed working well in testing).
  targetShotCount   Int?
  orientation       String?                    @default("9:16")
  // Managed Agent session ID used for this campaign's approval (audit trail)
  approvalSessionId String?
  posts             VideoPost[]
  logs              VideoCampaignLog[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
  @@index([weekStart])
}

/// Standalone character roster, additive to Section.videoCharacterId — a
/// section's tied character is unchanged/unaffected by this. Used by custom
/// videos (VideoPost.customCharacterId), which aren't derived from an
/// article/section at all and need to pick a trained character directly.
model VideoCharacter {
  id                 String      @id @default(uuid())
  name               String
  persona            String?     @db.Text
  tone               String?
  // Higgsfield Reference Element ID — null until trained via the Character
  // Admin Agent (same training flow used for section characters).
  videoCharacterId   String?
  referenceImageUrls String[]    @default([])
  videoPosts         VideoPost[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model VideoPost {
  id                           String               @id @default(uuid())
  // Optional — a custom video (see customTitle/customContent below) can
  // stand entirely on its own, with no parent campaign.
  campaignId                   String?
  // Optional — null for a custom video (content provided directly rather
  // than derived from an article).
  articleId                    String?
  status                       VideoPostStatus      @default(pending)
  // Video Planner Agent session — Phase 1 only (drafts/redrafts the plan; a
  // tool-less agent, can never spend real generation credits). Separate from
  // directorSessionId below since these are two different agent definitions
  // and a session is pinned to one specific agent for its whole lifetime.
  planSessionId                String?
  // Video Director Agent session — created once Phase 3 (execute) starts,
  // reused for any later single-segment regeneration in PHASE:
  // regenerate_segment, so the agent always retains full context (including
  // the character anchor still's job id) of the rest of the video.
  directorSessionId            String?
  // Optional one-off human creative direction (mirrors the `instruction` param
  // on regeneratePostContent), applied on the next regenerate/re-plan
  directorNote                 String?              @db.Text
  // Per-post overrides of the campaign's Plan → Approve → Execute config
  // (null = inherit the campaign's value)
  targetPlatform               VideoTargetPlatform?
  videoStyle                   VideoStyle?
  targetShotCount              Int?
  orientation                  String?
  // Phase 1 output — the agent's DRAFT narration + segment breakdown, before
  // approval and before anything is generated. Distinct from the VideoSegment
  // rows below: `plan` is the pre-approval proposal (editable, no video URLs),
  // VideoSegment rows are what Phase 3 execution actually materializes as it
  // generates each segment (or regenerates one later).
  plan                         Json?
  // The full continuous narration script (spoken across all segments, on-camera
  // and voiceover-b-roll alike) — set once the plan is approved/executed.
  narration                    String?              @db.Text
  // Custom video fields — set instead of articleId when this post's content
  // is provided directly rather than derived from an article. Exactly one of
  // articleId or (a character + customContent) should be set; enforced
  // at the application layer, not a DB constraint.
  customTitle                  String?
  customContent                String?              @db.Text
  // A custom video's on-screen character is either a roster VideoCharacter or
  // an existing section's already-trained character — exactly one of these two
  // is set (application-enforced).
  customCharacterId            String?
  customCharacter              VideoCharacter?      @relation(fields: [customCharacterId], references: [id], onDelete: SetNull)
  customSectionId              String?
  customSection                Section?             @relation(fields: [customSectionId], references: [id], onDelete: SetNull)
  // Per-post override of the global VideoEnvironment singleton ("KG Media
  // Loft"). Both null (the default) means use the singleton exactly as before.
  customEnvironmentName        String?
  customEnvironmentDescription String?              @db.Text
  segments                     VideoSegment[]
  // Caption editable by user before scheduling; AI-generated initially
  generatedText                String?              @db.Text
  hashtags                     String[]             @default([])
  // Assembled (concat + music + optional captions) final clip, uploaded to
  // DigitalOcean Spaces. Only ever produced by the manual "re-assemble" step.
  videoUrl                     String?
  duration                     Int?
  aspectRatio                  String?
  genre                        String?
  // Pre-music, pre-captions concatenated base render — kept so a music-only
  // regeneration never has to re-download/re-normalize/re-concatenate segments
  narrationVideoUrl            String?
  // Background music — generated once per assembly pass, re-usable across
  // re-assembles unless segments/duration changed enough to warrant a fresh track
  musicUrl                     String?
  // Per-post override of VideoSettings.musicVolume (null = inherit default)
  musicVolume                  Float?
  // Per-post override of VideoSettings.captionsEnabled (null = inherit default)
  captionsEnabled              Boolean?
  // Aggregate cost/time across all segments + assembly, refreshed on every
  // re-assemble (see VideoSegment for the per-segment breakdown)
  totalGenerationTimeMs        Int?
  totalEstimatedCost           Float?
  // Which Buffer channels this same video fans out to (e.g. ["instagram_carousel","linkedin","twitter"])
  platforms                    String[]             @default([])
  // Buffer post ID per platform: { "instagram_carousel": "...", "linkedin": "..." }
  bufferPostIds                Json?
  scheduledAt                  DateTime?
  analyticsData                Json?
  errorMessage                 String?              @db.Text
  campaign                     VideoCampaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  article                      Article?             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@index([campaignId])
  @@index([articleId])
  @@index([customSectionId])
  @@index([status])
}

/// One row per directed segment — materialized during Phase 3 execution from the
/// post's approved `plan`. Lets a single segment be regenerated (reusing the
/// director's existing session) without touching/re-generating the rest of the
/// (expensive) video. See VIDEO_CAMPAIGN_OPS.md / the plan doc for the full
/// cost-control rationale.
model VideoSegment {
  id                    String                @id @default(uuid())
  postId                String
  order                 Int
  hasCharacter          Boolean               @default(false)
  // This segment's slice of the post's full continuous narration
  spokenPortion         String?               @db.Text
  visualDescription     String?               @db.Text
  // Raw Higgsfield clip (native audio already baked in — dialogue if
  // hasCharacter, off-screen voiceover narration otherwise)
  videoUrl              String?
  duration              Float?
  status                VideoSegmentStatus    @default(pending)
  higgsfieldJobId       String?
  errorMessage          String?               @db.Text
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  // Always a rate-card ESTIMATE — Higgsfield exposes no cost/credits API at all
  // (confirmed: dashboard-only, cloud.higgsfield.ai). Never a real billed value.
  estimatedCost         Float?
  // Which VideoSegmentVersion the fields above currently mirror. Null for rows
  // that predate versioning.
  activeVersionId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  post                  VideoPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  versions              VideoSegmentVersion[]

  @@index([postId])
  @@index([status])
  @@index([postId, order])
}

// Every clip a segment has ever had. Regeneration is expensive and its result
// is not reliably better than what it replaced, so nothing is ever discarded —
// old clips stay listed and restorable instead of being deleted.
model VideoSegmentVersion {
  id              String                    @id @default(uuid())
  segmentId       String
  // 1-based, per segment
  version         Int
  videoUrl        String?
  duration        Float?
  higgsfieldJobId String?
  estimatedCost   Float?
  source          VideoSegmentVersionSource @default(generated)
  // Director note that produced this take, or the human's reason for a manual URL
  note            String?                   @db.Text
  createdAt       DateTime                  @default(now())
  segment         VideoSegment              @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([segmentId, version])
  @@index([segmentId])
}

/// Detailed trace of every pipeline step — used for the live run log UI (mirrors SocialCampaignLog)
model VideoCampaignLog {
  id         String         @id @default(uuid())
  // Optional — a custom, campaign-less video still logs activity, keyed by
  // postId alone.
  campaignId String?
  postId     String?
  step       String
  status     String         @default("running")
  message    String?        @db.Text
  input      Json?
  output     Json?
  campaign   VideoCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([campaignId])
  @@index([postId])
  @@index([step])
}

/// Global defaults + Anthropic Managed Agent references for the video pipeline.
/// Buffer channel IDs are intentionally NOT duplicated here — reuses SocialSettings'
/// instagramChannelId/linkedinChannelId/twitterChannelId.
model VideoSettings {
  id                          String              @id @default("singleton")
  // Video Approval Agent — selects which articles get a video this cycle
  approvalAgentId             String?
  approvalEnvironmentId       String?
  // Video Planner Agent — Phase 1 only. Text-only, no Higgsfield tools
  // enabled at all, so planning can never spend a real generation credit —
  // a structural guarantee, not just a prompt instruction. Drafts/redrafts
  // the narration + segment breakdown + wardrobe/look decision.
  plannerAgentId              String?
  plannerEnvironmentId        String?
  // Video Director Agent — Phase 3 (execute) + single-segment regeneration.
  // Directs the actual shoot via Higgsfield's hosted MCP server
  // (mcp.higgsfield.ai) rather than custom tools — this is what actually
  // unlocks Seedance 2.0 / native audio, which the Developer/Partner REST
  // API (services/higgsfield.service.js) does not expose. Separate from the
  // Planner Agent above — a session is pinned to one agent for its whole
  // lifetime, so these can't share a session even though they cooperate on
  // the same video.
  directorAgentId             String?
  directorEnvironmentId       String?
  // Character Admin Agent — one-off sessions only, creates/updates the Higgsfield
  // Reference Element each section's characterId points to (see app/api/video/characters).
  // Never used by the per-post director.
  characterAdminAgentId       String?
  characterAdminEnvironmentId String?
  // Vault holding the Higgsfield MCP OAuth credential (see docs/managed-agents/vaults) —
  // referenced as vault_ids on every session that talks to the Higgsfield MCP server.
  higgsfieldVaultId           String?
  defaultMaxVideosPerCampaign Int                 @default(5)
  defaultDuration             Int                 @default(15)
  defaultAspectRatio          String              @default("9:16")
  defaultGenre                String              @default("auto")
  defaultPlatforms            String[]            @default(["instagram_carousel", "linkedin", "twitter"])
  maxGenerationsPerPost       Int                 @default(4)
  // When false: pipeline auto-schedules immediately after upload (no review pause)
  requireReview               Boolean             @default(true)
  // ElevenLabs Music — background bed mixed under the narration at assembly time
  musicEnabled                Boolean             @default(true)
  musicVolume                 Float               @default(0.3)
  elevenlabsMusicModelId      String              @default("music_v2")
  // Captions.ai (Mirage API) — animated captions burned in at assembly time.
  // Default is the real "Aries" template ID confirmed in testing — condensed
  // enough to stay within frame margins (unlike "Magazine", which overflowed).
  captionsEnabled             Boolean             @default(true)
  captionsTemplateId          String?             @default("ctpl_pUtOSPltDzsoYJgLBYmo")
  captionsTemplateName        String?             @default("Aries")
  // Branded outro clip appended to the end of every assembled video, BEFORE
  // background music is generated/mixed — so the music bed is generated to
  // cover the full segments+outro duration and continues playing under the
  // outro too, rather than cutting off when the outro starts.
  outroEnabled                Boolean             @default(true)
  outroVideoUrl               String?
  // Plan → Approve → Execute defaults (each overridable per-campaign/per-post)
  defaultTargetPlatform       VideoTargetPlatform @default(auto)
  defaultVideoStyle           VideoStyle          @default(auto)
  defaultTargetShotCount      Int?
  defaultOrientation          String              @default("9:16")
  updatedAt                   DateTime            @updatedAt
}

/// Runtime state for the ongoing Video Approval Agent session (mirrors SocialAiMemory)
model VideoAiMemory {
  id                   String   @id @default("singleton")
  activeSessionId      String?
  sessionCampaignCount Int      @default(0)
  sessionRotateAfter   Int      @default(10)
  handoffSummary       String?  @db.Text
  updatedAt            DateTime @updatedAt
}

enum VideoFailureType {
  nsfw
  ip_detected
  quality
  timeout
}

/// DB-backed, ever-growing equivalent of seedance-failures.md — injected as
/// dynamic context into each director session so the content-filter map keeps
/// improving without re-uploading the director agent's Skill.
model VideoPromptLearning {
  id            String           @id @default(uuid())
  triggerPhrase String
  failureType   VideoFailureType
  safeRewrite   String?          @db.Text
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([failureType])
}
